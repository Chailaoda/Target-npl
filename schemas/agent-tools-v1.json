[
  {
    "name": "screening_platforms",
    "description": "只读平台接入目录；配置浏览器不代表已登录或真实采集验收通过",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "screening_platform_login",
    "description": "仅在用户准备本人登录时打开指定平台的专用直连窗口；不自动登录或启动采集",
    "inputSchema": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "douyin",
            "xhs",
            "kuaishou",
            "bilibili",
            "weibo",
            "tieba",
            "zhihu"
          ]
        }
      },
      "required": [
        "platform"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "screening_capabilities",
    "description": "读取真实采集和后处理能力，地域/时间不是平台原生过滤",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "screening_task_get",
    "description": "读取人工最新修改后的统一任务、ETag 和生效版本；调整前必须先读取",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "screening_task_submit",
    "description": "在已授权额度内，一次自然语言目标自动制定、校验、应用并启动；同 request_id 不重复规划/启动，关键问题返回 needs_attention",
    "inputSchema": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "base_etag": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "required": [
        "goal",
        "base_etag",
        "request_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "screening_task_plan",
    "description": "一次模型调用把自然语言目标编译为当前模板的字段变更；只返回草稿，不执行或应用",
    "inputSchema": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "base_etag": {
          "type": "string"
        }
      },
      "required": [
        "goal",
        "base_etag"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
